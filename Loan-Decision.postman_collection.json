      "description": "Comportamento HTTP disponível desde a Tarefa 1.",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"returns the health contract\", function () {",
                  "  pm.expect(pm.response.json()).to.eql({ status: \"ok\" });",
                  "});",
                  "",
                  "pm.test(\"returns JSON\", function () {",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "Confirma que o processo HTTP está disponível. Requer o serviço iniciado com PORT=3000.",
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "response": [
            {
