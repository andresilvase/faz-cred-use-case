{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Arc Gate Rules",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "version",
        "repository",
        "rules"
    ],
    "properties": {
        "version": {
            "const": 1
        },
        "repository": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "service",
                "purpose"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "service": {
                    "type": "string",
                    "minLength": 1
                },
                "purpose": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "rules": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/definitions/rule"
            }
        }
    },
    "definitions": {
        "nonEmptyStringArray": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "rule": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "type",
                "category",
                "severity",
                "statement",
                "triggers",
                "enforcement"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "type": {
                    "enum": [
                        "domain-invariant",
                        "system-invariant",
                        "contract-invariant",
                        "data-invariant",
                        "architectural-constraint",
                        "repository-policy"
                    ]
                },
                "category": {
                    "enum": [
                        "business",
                        "consistency",
                        "reliability",
                        "data-integrity",
                        "architecture",
                        "security",
                        "operational"
                    ]
                },
                "severity": {
                    "enum": [
                        "critical",
                        "high",
                        "medium",
                        "low"
                    ]
                },
                "statement": {
                    "type": "string",
                    "minLength": 1
                },
                "triggers": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "paths"
                    ],
                    "properties": {
                        "paths": {
                            "$ref": "#/definitions/nonEmptyStringArray"
                        }
                    }
                },
                "evidence": {
                    "type": "object",
                    "additionalProperties": false,
                    "minProperties": 1,
                    "properties": {
                        "implementation": {
                            "$ref": "#/definitions/nonEmptyStringArray"
                        },
                        "tests": {
                            "$ref": "#/definitions/nonEmptyStringArray"
                        }
                    }
                },
                "scope": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "paths"
                    ],
                    "properties": {
                        "paths": {
                            "$ref": "#/definitions/nonEmptyStringArray"
                        }
                    }
                },
                "constraints": {
                    "type": "object",
                    "additionalProperties": false,
                    "minProperties": 1,
                    "properties": {
                        "forbidden_imports": {
                            "$ref": "#/definitions/nonEmptyStringArray"
                        },
                        "forbidden_packages": {
                            "$ref": "#/definitions/nonEmptyStringArray"
                        },
                        "forbidden_expressions": {
                            "$ref": "#/definitions/nonEmptyStringArray"
                        }
                    }
                },
                "enforcement": {
                    "$ref": "#/definitions/enforcement"
                }
            }
        },
        "enforcement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "mode",
                "blocking"
            ],
            "properties": {
                "mode": {
                    "enum": [
                        "test",
                        "static-analysis",
                        "scanner"
                    ]
                },
                "command": {
                    "type": "string",
                    "minLength": 1
                },
                "scanner": {
                    "type": "string",
                    "minLength": 1
                },
                "local": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "command",
                        "strategy"
                    ],
                    "properties": {
                        "command": {
                            "type": "string",
                            "minLength": 1
                        },
                        "strategy": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                "ci": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "workflow",
                        "strategy"
                    ],
                    "properties": {
                        "workflow": {
                            "type": "string",
                            "minLength": 1
                        },
                        "strategy": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                "produces": {
                    "$ref": "#/definitions/nonEmptyStringArray"
                },
                "blocking": {
                    "type": "boolean"
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "mode": {
                                "enum": [
                                    "test",
                                    "static-analysis"
                                ]
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "command"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "mode": {
                                "const": "scanner"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "scanner"
                        ],
                        "anyOf": [
                            {
                                "required": [
                                    "command"
                                ]
                            },
                            {
                                "required": [
                                    "local"
                                ]
                            }
                        ]
                    }
                }
            ]
        }
    }
}