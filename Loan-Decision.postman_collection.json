    {
      "name": "Loan decisions",
      "description": "Comportamentos HTTP disponíveis desde a Tarefa 13. Execute esta pasta na ordem apresentada.",
      "item": [
        {
          "name": "Approval",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const response = pm.response.json();",
                  "pm.test(\"returns the public approval contract\", function () {",
                  "  pm.expect(response.decision).to.eql(\"APPROVED\");",
                  "  pm.expect(response.message).to.eql(\"O valor solicitado foi aprovado.\");",
                  "  pm.expect(response.loan_id).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(Object.keys(response).sort()).to.eql([\"decision\", \"loan_id\", \"message\"]);",
                  "});",
                  "pm.collectionVariables.set(\"approved_loan_id\", response.loan_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "postman-approval-key",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"borrower_id\": \"postman-approved-borrower\",\n  \"uf\": \"GO\",\n  \"amount\": 500000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Cria uma intenção aprovada; chave e payload fixos tornam novas execuções idempotentes.",
            "url": {
              "raw": "{{base_url}}/loan-decisions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "loan-decisions"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Replay approval",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const response = pm.response.json();",
                  "pm.test(\"replays the same approval\", function () {",
                  "  pm.expect(response.loan_id).to.eql(pm.collectionVariables.get(\"approved_loan_id\"));",
                  "  pm.expect(response).not.to.have.property(\"policy_version\");",
                  "  pm.expect(response).not.to.have.property(\"policyVersion\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "postman-approval-key",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"borrower_id\": \"postman-approved-borrower\",\n  \"uf\": \"GO\",\n  \"amount\": 500000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Repete exatamente a aprovação anterior.",
            "url": {
              "raw": "{{base_url}}/loan-decisions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "loan-decisions"
              ]
            }
          },
          "response": []
        },
